#!/bin/sh
# cc-close — laufende Claude-Code-Session sauber beenden und ihren iTerm-Tab schließen.
#
#   cc-close [--force] NAME
#
# Tippt `/exit` in die Session (gefunden über ihr Terminal: tmux-Pane im Server der hive-App bzw.
# im Standard-Server, sonst iTerm-Tab), wartet auf das Ende des Prozesses und schließt
# die tmux-Session bzw. den Tab. Ohne --force abgelehnt, wenn die Session gerade arbeitet
# oder kein Handover hat. Die eigene Session lässt sich nicht schließen.
# Umgebung: CC_HOME (Standard ~/.claude), CLAUDE_PID, CC_CLOSE_DRYRUN=1 prüft nur.
set -eu

home="${CC_HOME:-$HOME/.claude}"
force=0
if [ "${1:-}" = "--force" ]; then force=1; shift; fi
if [ $# -ne 1 ]; then
  echo "usage: cc-close [--force] NAME" >&2
  exit 2
fi
name="$1"
case "$name" in
  ""|*[!A-Za-z0-9._#-]*|*..*) echo "cc-close: ungültiger Name '$name'" >&2; exit 2 ;;
esac

pid=""; status=""
for f in "$home"/sessions/*.json; do
  [ -f "$f" ] || continue
  [ "$(jq -r '.name // empty' "$f" 2>/dev/null)" = "$name" ] || continue
  p=$(jq -r '.pid // empty' "$f" 2>/dev/null)
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
    pid="$p"; status=$(jq -r '.status // empty' "$f" 2>/dev/null); break
  fi
done
if [ -z "$pid" ]; then
  echo "cc-close: keine laufende Session '$name'" >&2
  exit 1
fi
if [ "$pid" = "${CLAUDE_PID:-}" ]; then
  echo "cc-close: die eigene Session lässt sich nicht schließen" >&2
  exit 1
fi
if [ "$force" -eq 0 ] && [ "$status" = "busy" ]; then
  echo "cc-close: '$name' arbeitet gerade; erst fertig werden lassen oder --force" >&2
  exit 1
fi
if [ "$force" -eq 0 ] && [ ! -f "$home/handover/$name.md" ]; then
  echo "cc-close: '$name' hat kein Handover; erst /handover schreiben lassen oder --force" >&2
  exit 1
fi

tty=$(ps -o tty= -p "$pid" | tr -d ' ')
if [ -z "$tty" ] || [ "$tty" = "??" ]; then
  echo "cc-close: '$name' hat kein Terminal" >&2
  exit 1
fi
tty="/dev/${tty#/dev/}"

if [ "${CC_CLOSE_DRYRUN:-}" = "1" ]; then
  echo "cc-close: würde '$name' (PID $pid, $tty) beenden"
  exit 0
fi

waitexit() {
  i=0
  while kill -0 "$pid" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -le 30 ] || return 1
    sleep 0.5
  done
}

# Läuft die Session in tmux (Server der hive-App oder Standard-Server)? Dann über tmux beenden.
tmux_bin=$(command -v tmux || true)
if [ -n "$tmux_bin" ]; then
  for server in hive default; do
    sess=$(env -u TMUX "$tmux_bin" -L "$server" list-panes -a -F '#{pane_tty} #{session_name}' 2>/dev/null \
      | awk -v t="$tty" '$1 == t {print $2; exit}')
    [ -n "$sess" ] || continue
    env -u TMUX "$tmux_bin" -L "$server" send-keys -t "=$sess:" -l "/exit"
    env -u TMUX "$tmux_bin" -L "$server" send-keys -t "=$sess:" Enter
    if ! waitexit; then
      echo "cc-close: '$name' hat sich nach 15 s nicht beendet; tmux-Session bleibt" >&2
      exit 1
    fi
    env -u TMUX "$tmux_bin" -L "$server" kill-session -t "=$sess:" 2>/dev/null || true
    echo "cc-close: $name beendet (tmux $server)"
    exit 0
  done
fi

itermdo() {
  osascript - "$tty" "$1" <<'EOF'
on run argv
  set target to item 1 of argv
  set action to item 2 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if tty of s is target then
            if action is "exit" then
              tell s to write text "/exit"
            else
              tell s to close
            end if
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "notfound"
end run
EOF
}

if [ "$(itermdo exit)" != "ok" ]; then
  echo "cc-close: kein iTerm-Tab mit $tty gefunden" >&2
  exit 1
fi
if ! waitexit; then
  echo "cc-close: '$name' hat sich nach 15 s nicht beendet; Tab bleibt offen" >&2
  exit 1
fi
itermdo close >/dev/null || true
echo "cc-close: $name beendet"
