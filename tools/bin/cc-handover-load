#!/bin/sh
# cc-handover-load — SessionStart/UserPromptSubmit hook.
# Outputs the handover of the predecessor session with the same name once as context
# and sets the task line to "restarted, handover read". Never exits ≠ 0.
#
# Marker rule: as soon as this session's name can be resolved for the first time,
# ~/.claude/handover/.loaded/<session_id> is created, whether a handover file exists
# or not. Only a file that already exists at that moment counts as the predecessor's
# handover. A file the session later creates itself via /status is thus
# never loaded back into the same context as someone else's handover.
home="${CC_HOME:-$HOME/.claude}"
cc_task="${CC_TASK:-$HOME/.claude/bin/cc-task}"

input=$(cat 2>/dev/null || true)
session_id=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null || true)

reg=""
if [ -n "${CLAUDE_PID:-}" ] && [ -f "$home/sessions/$CLAUDE_PID.json" ]; then
  reg="$home/sessions/$CLAUDE_PID.json"
elif [ -n "$session_id" ]; then
  for f in "$home"/sessions/*.json; do
    [ -f "$f" ] || continue
    if [ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" = "$session_id" ]; then reg="$f"; break; fi
  done
fi
[ -n "$reg" ] || exit 0

# Only names set by the user (claude -n / /rename); derived names get no handover.
name=$(jq -r 'select(.nameSource != "derived") | .name // empty' "$reg" 2>/dev/null || true)
[ -n "$name" ] || exit 0
[ -n "$session_id" ] || session_id=$(jq -r '.sessionId // empty' "$reg" 2>/dev/null || true)

marker="$home/handover/.loaded/${session_id:-$CLAUDE_PID}"
[ -f "$marker" ] && exit 0
mkdir -p "$home/handover/.loaded" 2>/dev/null && : > "$marker"

file="$home/handover/$name.md"
[ -f "$file" ] || exit 0

printf 'Handover of the predecessor session %s (from %s). Read it as your starting point; the task line is set to "restarted", set it via ~/.claude/bin/cc-task as soon as you have a task.\n\n' "$name" "$file"
cat "$file"
printf '\n'

sh "$cc_task" --name "$name" --no-create "restarted, handover read" working >/dev/null 2>&1 || true
exit 0
